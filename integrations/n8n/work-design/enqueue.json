{
  "name": "JobVarejo | Enfileirar encarte Work",
  "description": "Piloto privado por lotes. Entrada: request objeto e idempotencyKey UUID estável; saída pedido persistido. Retentativas mantêm a mesma chave.",
  "active": false,
  "nodes": [
    {
      "id": "19867ca8-f1b3-4681-a704-e04845459701",
      "name": "Entrada",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "request",
              "type": "object"
            },
            {
              "name": "idempotencyKey",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "90b4ef4c-85c2-42cb-82ee-7a6499840932",
      "name": "JobVarejo piloto",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        260,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://jobvarejo.com.br/api/work-design/n8n/jobs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({request:$json.request,idempotencyKey:$json.idempotencyKey}) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "JobVarejo | Work n8n piloto"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueErrorOutput",
      "notes": "Credencial exclusiva n8n: Authorization: Bearer WORK_DESIGN_N8N_TOKEN. Não usar token do Work. Piloto inativo até release, migração e configuração."
    },
    {
      "id": "fe93a760-a01f-44b6-90b3-50edeef7d382",
      "name": "Retornar resultado",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        520,
        0
      ],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ JSON.stringify($json) }}",
        "options": {}
      }
    },
    {
      "id": "35fc1d12-8162-4da5-ba58-66f45db3e103",
      "name": "Falha visível",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        520,
        180
      ],
      "parameters": {
        "errorMessage": "JobVarejo Work: operação falhou após retentativas. Conferir credencial, ativação, revisão e entrada do pedido. Não declarar sucesso."
      }
    }
  ],
  "connections": {
    "Entrada": {
      "main": [
        [
          {
            "node": "JobVarejo piloto",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "JobVarejo piloto": {
      "main": [
        [
          {
            "node": "Retornar resultado",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Falha visível",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all"
  }
}
